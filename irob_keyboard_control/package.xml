<?xml version="1.0"?>
<package format="3">
  <name>irob_keyboard_control</name>
  <version>0.0.1</version>
  <description>Keyboard teleoperation package for sending iROB motor commands to ESP32.</description>
  <maintainer email="irob@example.com">iROB Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>irob_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rqt_graph</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
